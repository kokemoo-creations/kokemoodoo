<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add FlagShip-specific fields to Delivery Method form -->
    <record id="view_delivery_carrier_form_inherit_flagship" model="ir.ui.view">
        <field name="name">delivery.carrier.form.inherit.flagship</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="flagship_api_key" options="{'password': True}"/>
                <field name="flagship_account_id"/>
            </xpath>
        </field>
    </record>

    <!-- Add FlagShip selection to delivery method provider -->
    <record id="view_delivery_carrier_form_inherit_flagship_provider" model="ir.ui.view">
        <field name="name">delivery.carrier.form.inherit.flagship.provider</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='delivery_type']" position="after">
                <field name="delivery_type" domain="[('delivery_type', 'in', ('flagship', 'base_on_rule'))]"/>
            </xpath>
        </field>
    </record>
</odoo>